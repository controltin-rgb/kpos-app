{
  // Editor-only umbrella config. `pnpm typecheck` checks node and web code separately
  // (tsconfig.node.json / tsconfig.web.json) so renderer code cannot use Node types.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*", "*.config.ts"]
}
